{
  "name": "lexarr",
  "version": "0.24.0",
  "description": "Unified media request portal for movies, TV, music, and books",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "next dev --turbopack",
    "build": "prisma generate && next build",
    "start": "next start",
    "db:studio": "prisma studio",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "lint": "eslint src/ e2e/ scripts/",
    "prepare": "husky",
    "e2e": "playwright test"
  },
  "dependencies": {
    "@prisma/client": "^5.22.0",
    "@tailwindcss/postcss": "^4.3.4",
    "@types/node": "^25.5.0",
    "@types/react": "^19.3.0",
    "bcryptjs": "^3.0.3",
    "next": "^16.4.5",
    "next-auth": "^5.0.0-beta.30",
    "postcss": "^8.5.32",
    "prisma": "^5.22.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "swr": "^2.5.1",
    "tailwindcss": "^4.2.2",
    "typescript": "^6.0.2",
    "zod": "^4.6.7"
  },
  "lint-staged": {
    "src/**/*.{ts,tsx}": [
      "eslint --fix",
      "vitest related --run"
    ]
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.65.0",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@types/bcryptjs": "^3.0.0",
    "@types/eslint__js": "^8.42.3",
    "@vitest/coverage-istanbul": "^4.1.12",
    "eslint": "^10.14.0",
    "globals": "^17.14.0",
    "husky": "^9.1.7",
    "jsdom": "^30.1.3",
    "lint-staged": "^16.4.0",
    "typescript-eslint": "^8.72.1",
    "vitest": "^4.1.12"
  }
}
