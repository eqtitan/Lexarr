datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

model User {
  id           String    @id @default(cuid())
  name         String    @unique  // P-01: login identifier; prevents concurrent-registration races
  email        String?   @unique
  password     String?
  plexId       String?   @unique
  jellyfinId   String?   @unique
  avatar       String?
  role         String    @default("user") // "admin" | "user"
  autoApprove  Boolean   @default(false)
  maxRequests  Int       @default(0) // 0 = unlimited
  // Bumped on password reset / role change; a session whose JWT carries an
  // older value is signed out (see the jwt callback in src/lib/auth/config.ts).
  sessionVersion Int     @default(0)
  createdAt    DateTime  @default(now())
  requests     Request[]
  auditLogs    AuditLog[]
}

model Request {
  id              String           @id @default(cuid())
  userId          String
  user            User             @relation(fields: [userId], references: [id])
  mediaType       String           // "movie" | "tv" | "music" | "book"
  externalId      String           // TMDB ID, MusicBrainz release-group ID, Open Library key
  externalId2     String?          // Secondary ID: MusicBrainz artist UUID for Lidarr
  title           String
  year            String?
  posterPath      String?
  status          String           @default("pending") // pending | approved | downloading | available | denied | failed | stalled
  adminNote       String?          // Admin note when approving/denying
  arrId           Int?             // ID in the *arr system after submission
  retryCount      Int              @default(0) // Manual admin retries (POST /api/admin/retry) — no hard cap, see services/retry.ts
  autoRetryCount  Int              @default(0) // Silent hourly auto-retries (status-checker.ts Tier A) — capped at MAX_AUTO_RETRIES. Separate from retryCount so a background cron attempt never eats into an admin's manual retry budget.
  lastError       String?          // Last error message from *arr submission
  approvedAt      DateTime?
  availableAt     DateTime?
  lastCheckedAt   DateTime?        // Last time status was synced from *arr or qBittorrent
  checkFailingSince DateTime?      // Set the first time a status check throws while arrId is set; cleared on the next successful check. Lets status-checker.ts tell "broken for 5 minutes" from "broken for 2 months" even though lastError is overwritten every cycle.
  qaPassed        Boolean?         // Whether QA check passed (file exists, size ok, subtitles ready)
  qaCheckedAt     DateTime?        // Last time QA was evaluated
  source          String           @default("lexarr") // "lexarr" | "system"
  releaseType     String?          // music only: "album" | "single" | "ep" | "other" — drives narrow-monitoring for singles/EPs
  bookFormat      String?          // book only: "ebook" | "audiobook" — routes LazyLibrarian to the correct search/download category
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt
  events          PipelineEvent[]

  @@index([userId])
  @@index([status])
  @@index([source])
  @@index([externalId, mediaType])  // P-03: hot path for checkDuplicate()
}

model PipelineEvent {
  id         String   @id @default(cuid())
  requestId  String
  request    Request  @relation(fields: [requestId], references: [id], onDelete: Cascade)
  event      String   // "submitted" | "approved" | "denied" | "sent_to_arr" | "downloading" | "available" | "failed" | "stalled" | "retried"
  detail     String?  // JSON blob: indexer, download client, file size, quality, errors
  createdAt  DateTime @default(now())

  @@index([requestId])
  @@index([event])
  @@index([createdAt])
}

model NotificationChannel {
  id        String   @id @default(cuid())
  name      String                        // Display name: "Discord #requests", "Slack General"
  type      String                        // "discord" | "slack" | "webhook"
  webhookUrl String
  events    String   @default("all")      // Comma-separated: "all" | "submitted,approved,available,failed"
  enabled   Boolean  @default(true)
  createdAt DateTime @default(now())
}

model AuditLog {
  id         String   @id @default(cuid())
  userId     String?
  user       User?    @relation(fields: [userId], references: [id])
  action     String   // "approve_request" | "deny_request" | "update_user" | "add_notification" | "retry_request" | "login"
  targetType String?  // "request" | "user" | "notification"
  targetId   String?  // ID of the affected entity
  detail     String?  // JSON context
  createdAt  DateTime @default(now())

  @@index([userId])
  @@index([action])
  @@index([createdAt])
}

/// Key/value store for admin-configurable settings that don't warrant
/// their own table. Value is JSON-encoded to keep schema simple — the
/// src/lib/settings.ts helpers handle encode/decode + defaults.
/// Current keys:
///   - music.allowedRegions : string[]   (ISO 3166-1 alpha-2 codes)
model AppSetting {
  key       String   @id
  value     String   // JSON-encoded
  updatedAt DateTime @updatedAt
}

/// Per-window rate-limit counter. Survives container restart so crash-loop
/// doesn't reset the auth-attempt budget. Keyed by (ipKey, windowStart)
/// where windowStart is unix seconds quantized to the config's window.
/// Old rows are swept by a background interval in src/lib/rate-limit.ts.
model RateLimitBucket {
  key         String
  windowStart Int     // unix seconds, quantized to windowSeconds
  count       Int     @default(1)

  @@id([key, windowStart])
  @@index([windowStart])  // for the sweep query
}

/// Lookups worth keeping across restarts (MusicBrainz chart matches).
/// See src/lib/persistent-cache.ts.
model CacheEntry {
  key       String   @id
  value     String   // JSON-encoded
  expiresAt DateTime

  @@index([expiresAt])
}
