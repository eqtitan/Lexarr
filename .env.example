# ============================================================
# Lexarr Configuration
# ============================================================
# Copy this file to `.env` and fill in your values.
# Every variable below is annotated with:
#   (required)  — Lexarr won't start without it
#   (optional)  — enables an extra feature; safe to leave empty
#   Where to find it — for keys / URLs sourced from other apps
#
# Secrets should never be committed. `.env` is already in .gitignore.
# ============================================================

# ── Core ────────────────────────────────────────────────────────────

# (required) SQLite database path. Inside Docker, the default
# `file:/app/data/lexarr.db` is correct — the path points at the
# lexarr-data volume. Only change this if you're running Lexarr
# outside Docker or want the DB at a non-default path.
DATABASE_URL=file:/app/data/lexarr.db

# (required) Random string used to sign NextAuth session cookies.
# Generate a fresh one with:  openssl rand -base64 32
# NEVER reuse the default or share across deployments — rotating
# this value invalidates every active session.
NEXTAUTH_SECRET=change-me-to-a-random-string

# (required) Public URL where users reach Lexarr.
# Examples:   http://localhost:5056   (local dev)
#             http://192.168.1.100:5056   (LAN)
#             https://lexarr.example.com   (behind a TLS reverse proxy)
NEXTAUTH_URL=http://localhost:5056

# (required in Docker / LAN) Tells NextAuth to trust the host header
# rather than rejecting non-localhost requests. Set to `true` for
# every non-dev deployment.
AUTH_TRUST_HOST=true

# (required) Shared secret for webhook receivers. *arr apps call
# /api/webhooks/radarr?token=$LEXARR_WEBHOOK_SECRET on state changes.
# Must match what you configure in each *arr's Settings → Connect →
# Webhook URL. An unset value rejects all webhooks (fail-safe).
# Generate with:  openssl rand -hex 16
LEXARR_WEBHOOK_SECRET=

# ── *arr stack ──────────────────────────────────────────────────────

# (required) Base URL (scheme + host, no trailing slash) for the Arr
# stack. Individual service URLs are built as $ARR_HOST:PORT
# automatically. If your arrs are on different hosts, edit
# src/lib/arr/*.ts directly — this single-host assumption is typical
# for home servers.
# Example:  http://192.168.1.100
ARR_HOST=http://your-server-ip

# (required for the relevant feature) *arr API keys.
# Find each key at:  http://<arr>:port/ → Settings → General → API Key
RADARR_API_KEY=
SONARR_API_KEY=
LIDARR_API_KEY=

# (optional) LazyLibrarian is the books backend.
# Find key at:  http://<host>:5299/ → Config → API
LAZYLIBRARIAN_API_KEY=
LAZYLIBRARIAN_PORT=5299

# (optional) Prowlarr — enables indexer stats on the admin dashboard.
# Find key at:  http://<host>:9696/ → Settings → General → API Key
PROWLARR_API_KEY=

# (optional) Bazarr — enables subtitle status in the dashboard.
# Find key at:  http://<host>:6767/ → Settings → General → API Key
# URL defaults to ARR_HOST on port 6767.
BAZARR_API_KEY=
BAZARR_URL=

# ── Download clients ────────────────────────────────────────────────

# (optional) qBittorrent Web UI — enables live queue visibility.
# URL is the Web UI endpoint (default: ARR_HOST on port 8080);
# user/pass are the Web UI creds.
QBITTORRENT_URL=
QBITTORRENT_USER=
QBITTORRENT_PASS=

# (optional) NZBGet — enables usenet queue actions from Lexarr.
# URL is the JSON-RPC endpoint (default: ARR_HOST on port 6789). Basic auth.
NZBGET_URL=
NZBGET_USER=
NZBGET_PASS=

# ── Search backends ─────────────────────────────────────────────────

# (required for movie/TV search) TMDB API key.
# Free signup at:  https://www.themoviedb.org/settings/api
TMDB_API_KEY=

# (optional) Last.fm API key — enables artist-popularity tiebreak on
# music search. When set, exact-title matches (e.g. "centuries")
# surface results from well-known artists (Fall Out Boy) above
# obscure cover bands with the same song title. Without a key, music
# search works identically to 0.12.x — ranked by MusicBrainz signals
# only. Get a free key (API access only, no auth dance) at:
# https://www.last.fm/api/account/create
LASTFM_API_KEY=

# ── Authentication providers ────────────────────────────────────────

# (optional) Plex SSO identifier.
# Default is `lexarr`; override only if Plex asks for a distinct ID.
PLEX_CLIENT_ID=lexarr

# (optional) Jellyfin auth + deep-linking.
# When set, enables "Sign in with Jellyfin" and makes the "Watch"
# button on the Requests page link into your Jellyfin web client.
# Use the address your users can reach, e.g. http://192.168.1.100:8096.
JELLYFIN_URL=

# ── Bootstrap admin (optional failover) ─────────────────────────────

# (optional) Creates an admin user on first boot if the DB is empty.
# Use this if you can't easily sign up through the UI — e.g. Plex/
# Jellyfin both unavailable, Lexarr locked down to pre-approved users.
# Leave empty for the normal "first signup becomes admin" flow.
# Once an admin exists these are ignored (Lexarr logs a warning while the
# password is still set) -- remove them after first boot. To rescue a
# forgotten password, set both plus BOOTSTRAP_ADMIN_RESET=true, restart,
# sign in, then remove all three.
BOOTSTRAP_ADMIN_USERNAME=
BOOTSTRAP_ADMIN_PASSWORD=
BOOTSTRAP_ADMIN_RESET=

# (optional) Allow signups after an admin exists. Defaults to false.
# Only set to `true` if you want anyone who can reach Lexarr to be
# able to register an account.
REGISTRATION_OPEN=false

# ── Rate limiting ───────────────────────────────────────────────────

# (optional) Number of reverse-proxy hops to trust when reading the
# X-Forwarded-For header for rate-limiting. Defaults to 0 (untrusted) —
# correct if Lexarr is exposed directly, since otherwise a client could
# spoof this header to dodge rate limits entirely. Only set this if you
# run Lexarr behind your own reverse proxy (nginx, Traefik, Caddy, etc.)
# that sets/appends the real client IP — almost always `1`.
#
# With this at 0, rate limiting falls back to a hash of each client's
# User-Agent + Accept-Language instead of one shared bucket for every
# direct visitor — so the household doesn't share a single budget, at
# the cost of being a weaker (spoofable) identity signal than a real IP.
TRUSTED_PROXY_HOPS=0

# (optional) A proxy running on the Docker host -- e.g. `tailscale serve`
# forwarding to 127.0.0.1:5056 -- reaches Lexarr from the Docker network's
# gateway, so without this every visitor through it shares one rate-limit
# bucket. List that gateway (docker network inspect <network>, "Gateway")
# and Lexarr believes the X-Forwarded-For the proxy appends, but only for
# connections from that exact address; LAN visitors keep their own address
# and can't forge one. Unlike TRUSTED_PROXY_HOPS, direct LAN access stays safe.
LEXARR_TRUSTED_PROXIES=

# (optional) Every address Lexarr is served at, comma-separated, primary first
# -- e.g. http://192.168.1.100:5056,https://server.<tailnet>.ts.net:8443 when
# also behind `tailscale serve`. Sign-in redirects use whichever listed address
# the visitor came in on (never an unlisted one). Remove NEXTAUTH_URL when you
# set this: next-auth would pin every redirect back to that single address.
LEXARR_PUBLIC_URLS=

# (optional) Responses that reach the visitor over HTTPS through a listed
# proxy carry Strict-Transport-Security with this max-age, in seconds
# (default 86400 = 1 day). Browsers keep it that long, whatever Lexarr does
# later, and it covers every port on that host name. Raise it (31536000 =
# 1 year) once HTTPS has proven itself; 0 tells browsers to forget it.
LEXARR_HSTS_MAX_AGE=

# (optional) Because those headers are spoofable, each route also has a
# shared ceiling across ALL clients while TRUSTED_PROXY_HOPS is 0, so a
# script rotating its User-Agent can't multiply its budget. The ceiling
# is this multiple of the per-client limit — default 4, e.g. login
# attempts 20/min and searches 120/min for everyone combined. Raise it
# if a busy household hits 429s; ignored when TRUSTED_PROXY_HOPS > 0.
RATE_LIMIT_CEILING_MULTIPLIER=4
