# Lexarr Configuration
# Copy this file to .env and fill in your values

# Database (SQLite — no changes needed for Docker, override for custom path)
DATABASE_URL=file:./lexarr.db

# NextAuth — generate a random secret: openssl rand -base64 32
NEXTAUTH_SECRET=change-me-to-a-random-string
NEXTAUTH_URL=http://localhost:5056

# Required for Docker/non-localhost deployments
AUTH_TRUST_HOST=true

# Host IP where your *arr stack runs (no trailing slash)
ARR_HOST=http://your-server-ip

# *arr API Keys — find in each app under Settings → General → API Key
RADARR_API_KEY=
SONARR_API_KEY=
LIDARR_API_KEY=
LAZYLIBRARIAN_API_KEY=
LAZYLIBRARIAN_PORT=5299

# Prowlarr API Key (optional)
PROWLARR_API_KEY=

# TMDB API Key — required for movie/TV search
# Get a free key at https://www.themoviedb.org/settings/api
TMDB_API_KEY=

# Plex SSO (optional — enables "Sign in with Plex")
PLEX_CLIENT_ID=lexarr

# Jellyfin URL (optional — enables Jellyfin login)
JELLYFIN_URL=http://your-server-ip:8096
